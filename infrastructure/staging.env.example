# Copy to infrastructure/.env.staging (git-ignored) and replace every value. Generate secrets, never reuse development ones:
#   openssl rand -base64 48        -> JWT_ACCESS_SECRET, INTERNAL_JOB_TOKEN, POSTGRES_PASSWORD, REDIS_PASSWORD
#   openssl rand -base64 32        -> DATA_ENCRYPTION_KEY (must decode to exactly 32 bytes)
# Use URL-safe passwords for POSTGRES_PASSWORD and REDIS_PASSWORD (letters and digits), since they are placed in connection URLs.
POSTGRES_USER=zentrix
POSTGRES_PASSWORD=
POSTGRES_DB=zentrix
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_JOB_TOKEN=

# Where the admin portal is reached (used for CORS) and which interface/port the container binds.
PUBLIC_ADMIN_ORIGIN=https://staging-admin.example.test
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080

# Staging only: lets an inviting admin see a new staff member's one-time setup token (there is no email delivery yet).
ALLOW_SETUP_TOKEN_IN_RESPONSE=false

# Optional features. Leave empty to keep them off.
ANTHROPIC_API_KEY=
AI_MODEL=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
