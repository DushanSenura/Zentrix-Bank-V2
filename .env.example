# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
APP_ENV=development            # development | staging | production

# --- API ---
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173

# --- Database (matches docker-compose.yml; change the password locally) ---
POSTGRES_USER=zentrix
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=zentrix
DATABASE_URL=postgresql://zentrix:change_me_local_only@localhost:5432/zentrix?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6380

# --- Auth (required from Phase 2; must be >= 32 chars outside development) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
