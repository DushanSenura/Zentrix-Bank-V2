# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
APP_ENV=development            # development | staging | production

# --- API ---
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173

# --- Database (matches docker-compose.yml; change the password locally) ---
POSTGRES_USER=zentrix
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=zentrix
DATABASE_URL=postgresql://zentrix:change_me_local_only@localhost:5432/zentrix?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6380

# --- Auth (REQUIRED, all environments) ---
# JWT_ACCESS_SECRET: >= 32 chars. DATA_ENCRYPTION_KEY: base64 of exactly 32 random bytes (AES-256-GCM for PII/MFA secrets).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
# Integration tests use a separate DB: createdb zentrix_test, migrate it, set TEST_DATABASE_URL
TEST_DATABASE_URL=
