{
  "name": "zentrix-bank-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Zentrix Bank V2 - full-stack digital banking SIMULATION platform (fictional data, no real banking networks).",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @zentrix/database generate",
    "db:migrate": "pnpm --filter @zentrix/database migrate:dev",
    "db:seed": "pnpm --filter @zentrix/api seed",
    "api:dev": "pnpm --filter @zentrix/api dev",
    "worker:dev": "pnpm --filter @zentrix/worker dev",
    "admin:dev": "pnpm --filter @zentrix/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "glob@>=9 <=14.0.1": ">=14.0.2",
      "minimatch@>=7 <11.0.1": ">=11.0.1",
      "effect": ">=3.22.1 <4"
    }
  }
}
