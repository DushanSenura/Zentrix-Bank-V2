// Zentrix Bank V2 - core schema (Phase 1 foundation).
// Money is ALWAYS integer minor units (BigInt). No floats for authoritative money.
// Remaining domains (cards, FD, loans, support, ...) are added in their own phases - see docs/database/schema-roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & security ─────────────────────────

enum UserType {
  CUSTOMER
  STAFF
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  MORE_INFO_REQUESTED
  APPROVED
  REJECTED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  type             UserType
  username         String     @unique
  email            String     @unique
  phone            String?
  passwordHash     String // Argon2id
  status           UserStatus @default(PENDING_VERIFICATION)
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  mfaSecretEnc     String? // encrypted TOTP secret (mandatory for staff)
  pinHash          String? // Argon2id hash of the 4/6-digit app PIN
  pinSetAt         DateTime?
  pinFailedAttempts Int      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer         CustomerProfile?
  staff            StaffProfile?
  roles            UserRole[]
  sessions         Session[]
  devices          TrustedDevice[]
  loginHistory     LoginHistory[]
  securityEvents   SecurityEvent[]
  challenges       AuthenticationChallenge[]
  notifications    Notification[]

  @@index([type, status])
}

model CustomerProfile {
  userId          String    @id @db.Uuid
  customerNumber  String    @unique
  fullName        String
  dateOfBirth     DateTime? @db.Date
  nationalIdEnc   String? // encrypted; never logged
  address         Json?
  kycStatus       KycStatus @default(NOT_SUBMITTED)
  kycReviewedById String?   @db.Uuid
  kycReviewedAt   DateTime?
  kycNote         String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])
  accounts        Account[]
  beneficiaries   Beneficiary[]
  applications    AccountApplication[]

  @@index([kycStatus])
}

model StaffProfile {
  userId     String   @id @db.Uuid
  employeeNo String   @unique
  fullName   String
  branchId   String?  @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. LOAN_OFFICER
  name        String
  system      Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. loans.approve
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique // hash only; rotated on every refresh
  deviceId         String?   @db.Uuid
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Single-use, expiring, hashed tokens (password reset, later OTP/step-up). Raw token is never stored.
model AuthenticationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  purpose    String // PASSWORD_RESET
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String
  label       String?
  trustedAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  identifier String? // as typed; masked at write time
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  kind      String // e.g. FORBIDDEN_RESOURCE_ACCESS, PASSWORD_CHANGED
  severity  String   @default("INFO")
  detail    Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([kind, createdAt])
}

// ───────────────────────── Accounts ─────────────────────────

enum AccountKind {
  SAVINGS
  CURRENT
  FIXED_DEPOSIT
  FOREIGN_CURRENCY
}

enum AccountStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model AccountProduct {
  id               String      @id @default(uuid()) @db.Uuid
  code             String      @unique
  name             String
  kind             AccountKind
  currency         String      @default("LKR")
  minOpeningMinor  BigInt      @default(100000) // V1 default LKR 1,000; bank-configurable
  interestRateBps  Int         @default(0)
  allowOverdraft   Boolean     @default(false)
  active           Boolean     @default(true)
  accounts         Account[]
  applications     AccountApplication[]
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  productId      String        @db.Uuid
  accountNumber  String        @unique
  nickname       String?
  currency       String        @default("LKR")
  status         AccountStatus @default(ACTIVE)
  openedAt       DateTime      @default(now())
  closedAt       DateTime?

  customer       CustomerProfile @relation(fields: [customerId], references: [userId])
  product        AccountProduct  @relation(fields: [productId], references: [id])
  ledgerAccount  LedgerAccount?
  statusHistory  AccountStatusHistory[]

  @@index([customerId, status])
}

model AccountStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @db.Uuid
  fromStatus  AccountStatus?
  toStatus    AccountStatus
  reasonCode  String
  actorId     String?       @db.Uuid
  createdAt   DateTime      @default(now())
  account     Account       @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

model AccountApplication {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @db.Uuid
  productId        String            @db.Uuid
  status           ApplicationStatus @default(SUBMITTED)
  requestedNickname String?
  decisionReason   String?
  decidedById      String?           @db.Uuid
  decidedAt        DateTime?
  openingDepositMinor BigInt? // cash received at the branch, confirmed by staff at approval
  accountId        String?           @db.Uuid // set when approved
  createdAt        DateTime          @default(now())

  customer         CustomerProfile   @relation(fields: [customerId], references: [userId])
  product          AccountProduct    @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
}

model Beneficiary {
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @db.Uuid
  bankCode      String // 'ZENTRIX' or simulated external bank code
  accountNumber String
  holderName    String
  nickname      String?
  favorite      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  customer      CustomerProfile @relation(fields: [customerId], references: [userId])

  @@unique([customerId, bankCode, accountNumber])
}

// ───────────────────────── Double-entry ledger ─────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum JournalStatus {
  POSTED
  REVERSED
}

/// A ledger account is either linked to a customer Account (a LIABILITY of the bank - customer deposits)
/// or is a bank-internal account (cash/settlement, fee income, etc.).
model LedgerAccount {
  id         String            @id @default(uuid()) @db.Uuid
  code       String            @unique
  name       String
  type       LedgerAccountType
  currency   String
  accountId  String?           @unique @db.Uuid
  /// Verified PROJECTION of posted entries (normal-side signed: credit-normal for LIABILITY/EQUITY/INCOME, debit-normal for ASSET/EXPENSE).
  /// The postings are the source of truth; reconciliation compares the two.
  balanceMinor  BigInt           @default(0)
  allowNegative Boolean          @default(false)
  createdAt  DateTime          @default(now())

  account    Account?          @relation(fields: [accountId], references: [id])
  postings   LedgerPosting[]
}

/// Append-only. Rows are never updated except the status flag REVERSED, and never deleted.
model LedgerJournal {
  id                 String         @id @default(uuid()) @db.Uuid
  reference          String         @unique // human/receipt reference
  kind               String // TRANSFER, FEE, FD_OPEN, ADJUSTMENT, REVERSAL ...
  currency           String
  status             JournalStatus  @default(POSTED)
  description        String?
  reversesJournalId  String?        @unique @db.Uuid
  paymentId          String?        @unique @db.Uuid
  postedAt           DateTime       @default(now())

  postings           LedgerPosting[]
  reverses           LedgerJournal? @relation("Reversal", fields: [reversesJournalId], references: [id])
  reversedBy         LedgerJournal? @relation("Reversal")
  payment            PaymentInstruction? @relation(fields: [paymentId], references: [id])
}

model LedgerPosting {
  id              String        @id @default(uuid()) @db.Uuid
  journalId       String        @db.Uuid
  ledgerAccountId String        @db.Uuid
  direction       Direction
  amountMinor     BigInt // > 0, enforced by DB CHECK
  currency        String
  createdAt       DateTime      @default(now())

  journal         LedgerJournal @relation(fields: [journalId], references: [id])
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([ledgerAccountId, createdAt])
  @@index([journalId])
}

// ───────────────────────── Payments ─────────────────────────

enum PaymentStatus {
  CREATED
  AWAITING_AUTHORIZATION
  AUTHORIZED
  PENDING_PROCESSING
  POSTED
  FAILED
  REJECTED
  CANCELLED
  REVERSED
}

enum PaymentKind {
  OWN_TRANSFER
  INTERNAL_TRANSFER
  INTERBANK_TRANSFER
  BILL_PAYMENT
  QR_PAYMENT
  LOAN_INSTALMENT
}

model PaymentInstruction {
  id               String        @id @default(uuid()) @db.Uuid
  reference        String        @unique
  kind             PaymentKind
  status           PaymentStatus @default(CREATED)
  initiatorId      String        @db.Uuid
  sourceAccountId  String        @db.Uuid
  destination      Json // validated server-side; shape depends on kind
  amountMinor      BigInt
  feeMinor         BigInt        @default(0) // computed by the backend only
  currency         String
  scheduledFor     DateTime?
  failureCode      String?
  idempotencyKey   String?
  note             String?
  scheduledPaymentId String?     @db.Uuid
  authorizedAt     DateTime?
  postedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  journal          LedgerJournal?
  authorizations   PaymentAuthorization[]

  @@unique([initiatorId, idempotencyKey])

  @@index([initiatorId, createdAt])
  @@index([sourceAccountId, createdAt])
  @@index([status, scheduledFor])
}

model PaymentAuthorization {
  id          String             @id @default(uuid()) @db.Uuid
  paymentId   String             @db.Uuid
  method      String // PIN | BIOMETRIC_ATTESTATION | OTP
  attempts    Int                @default(0)
  verifiedAt  DateTime?
  expiresAt   DateTime
  payment     PaymentInstruction @relation(fields: [paymentId], references: [id])
}

model IdempotencyRecord {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  userId          String   @db.Uuid
  scope           String // e.g. 'POST /v1/payments'
  requestHash     String // same key + different body => 422
  responseStatus  Int?
  responseBody    Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([userId, scope, key])
}

// ───────────────────────── Operations ─────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Maker-checker. The checker (decidedBy) must differ from the maker (requestedBy) - enforced in code and by CHECK.
model ApprovalRequest {
  id           String         @id @default(uuid()) @db.Uuid
  kind         String // LOAN_DISBURSEMENT, ACCOUNT_ADJUSTMENT ...
  subjectType  String
  subjectId    String
  payload      Json
  status       ApprovalStatus @default(PENDING)
  requestedBy  String         @db.Uuid
  decidedBy    String?        @db.Uuid
  reason       String?
  createdAt    DateTime       @default(now())
  decidedAt    DateTime?

  @@index([status, kind])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  actorType   String // CUSTOMER | STAFF | SYSTEM
  action      String
  subjectType String?
  subjectId   String?
  reasonCode  String?
  metadata    Json? // already masked
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
  @@index([action, createdAt])
}

/// Transactional outbox: written in the same DB transaction as the business change, delivered by the worker.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, createdAt])
}

model SystemConfiguration {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Phase 4: notifications & recurring payments ─────────────────────────

/// In-app notification centre. Rows are created by the worker from outbox events (never by clients).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  category  String // TRANSACTION | SECURITY | ACCOUNT ...
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Customer-authorised standing instruction (weekly/monthly). The worker turns each due run into a PaymentInstruction.
model ScheduledPayment {
  id              String    @id @default(uuid()) @db.Uuid
  customerId      String    @db.Uuid
  sourceAccountId String    @db.Uuid
  destination     Json
  amountMinor     BigInt
  currency        String    @default("LKR")
  note            String?
  frequency       String // WEEKLY | MONTHLY
  nextRunAt       DateTime
  endAt           DateTime?
  active          Boolean   @default(true)
  lastRunAt       DateTime?
  lastFailure     String?
  createdAt       DateTime  @default(now())

  @@index([active, nextRunAt])
  @@index([customerId])
}

// ───────────────────────── Phase 5: cards, deposits, loans, savings ─────────────────────────

enum CardKind {
  DEBIT
  VIRTUAL
  CREDIT
}

enum CardStatus {
  PENDING_APPROVAL
  PREPARING
  READY_TO_COLLECT
  ACTIVE
  FROZEN
  BLOCKED
  REJECTED
}

model Branch {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  city      String
  address   String
  type      String  @default("BRANCH") // BRANCH | ATM
  latitude  Float?
  longitude Float?
  phone     String?
  hours     String?
  active    Boolean @default(true)
}

/// NEVER holds a full card number or CVV. token is the simulated issuer reference; the PIN is an Argon2id hash
/// standing in for the issuer HSM.
model Card {
  id                 String      @id @default(uuid()) @db.Uuid
  customerId         String      @db.Uuid
  accountId          String      @db.Uuid
  kind               CardKind
  network            String      @default("VISA")
  status             CardStatus  @default(PENDING_APPROVAL)
  holderName         String
  last4              String?
  expiryMonth        Int?
  expiryYear         Int?
  token              String?     @unique
  pinHash            String?
  collectionBranchId String?     @db.Uuid
  readyOn            DateTime?
  creditLimitMinor   BigInt?
  application        Json?
  decisionReason     String?
  decidedById        String?     @db.Uuid
  decidedAt          DateTime?
  activatedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  controls           CardControls?
  history            CardStatusHistory[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model CardControls {
  cardId               String  @id @db.Uuid
  dailyLimitMinor      BigInt  @default(10000000)
  onlineEnabled        Boolean @default(true)
  internationalEnabled Boolean @default(false)
  contactlessEnabled   Boolean @default(true)
  card                 Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  cardId     String      @db.Uuid
  fromStatus CardStatus?
  toStatus   CardStatus
  reasonCode String
  actorId    String?     @db.Uuid
  createdAt  DateTime    @default(now())
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

model FixedDepositRate {
  id             String   @id @default(uuid()) @db.Uuid
  termMonths     Int      @unique
  rateBps        Int
  minAmountMinor BigInt   @default(1000000)
  active         Boolean  @default(true)
  updatedBy      String?  @db.Uuid
  updatedAt      DateTime @updatedAt
}

model FixedDeposit {
  id                     String   @id @default(uuid()) @db.Uuid
  reference              String   @unique
  customerId             String   @db.Uuid
  fundingAccountId       String   @db.Uuid
  ledgerAccountId        String   @unique @db.Uuid
  originalPrincipalMinor BigInt
  principalMinor         BigInt // current principal (grows when renewed with interest)
  rateBps                Int
  termMonths             Int
  startDate              DateTime
  maturityDate           DateTime
  renewal                String // WITH_INTEREST | WITHOUT_INTEREST | PAYOUT
  status                 String   @default("ACTIVE") // ACTIVE | MATURED | CLOSED
  renewalCount           Int      @default(0)
  createdAt              DateTime @default(now())

  renewals               FixedDepositRenewal[]
  closureRequests        FixedDepositClosureRequest[]

  @@index([customerId, status])
  @@index([status, maturityDate])
}

model FixedDepositRenewal {
  id                String       @id @default(uuid()) @db.Uuid
  fixedDepositId    String       @db.Uuid
  interestMinor     BigInt
  newPrincipalMinor BigInt
  newMaturityDate   DateTime
  createdAt         DateTime     @default(now())
  fixedDeposit      FixedDeposit @relation(fields: [fixedDepositId], references: [id])
}

model FixedDepositClosureRequest {
  id             String       @id @default(uuid()) @db.Uuid
  fixedDepositId String       @db.Uuid
  customerId     String       @db.Uuid
  status         String       @default("PENDING") // PENDING | APPROVED | REJECTED
  reason         String?
  decisionReason String?
  decidedById    String?      @db.Uuid
  decidedAt      DateTime?
  payoutMinor    BigInt?
  penaltyMinor   BigInt?
  createdAt      DateTime     @default(now())
  fixedDeposit   FixedDeposit @relation(fields: [fixedDepositId], references: [id])

  @@index([status, createdAt])
}

model LoanProduct {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique
  name           String
  minAmountMinor BigInt
  maxAmountMinor BigInt
  minTermMonths  Int
  maxTermMonths  Int
  rateBps        Int
  active         Boolean @default(true)
}

model LoanApplication {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String    @db.Uuid
  productId             String    @db.Uuid
  amountMinor           BigInt
  termMonths            Int
  monthlyIncomeMinor    BigInt
  employment            String
  purpose               String?
  disbursementAccountId String    @db.Uuid
  status                String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | DISBURSED | CANCELLED
  assessment            Json?
  decisionReason        String?
  decidedById           String?   @db.Uuid
  decidedAt             DateTime?
  approvalRequestId     String?   @db.Uuid
  loanId                String?   @db.Uuid
  createdAt             DateTime  @default(now())

  @@index([status, createdAt])
  @@index([customerId])
}

model Loan {
  id                    String    @id @default(uuid()) @db.Uuid
  reference             String    @unique
  applicationId         String    @unique @db.Uuid
  customerId            String    @db.Uuid
  productId             String    @db.Uuid
  principalMinor        BigInt
  rateBps               Int
  termMonths            Int
  status                String    @default("ACTIVE") // ACTIVE | CLOSED
  disbursementAccountId String    @db.Uuid
  ledgerAccountId       String    @unique @db.Uuid // ASSET account whose balance is the outstanding principal
  startDate             DateTime
  closedAt              DateTime?
  createdAt             DateTime  @default(now())

  schedule              LoanRepaymentSchedule[]
  payments              LoanPayment[]

  @@index([customerId, status])
}

model LoanRepaymentSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  loanId             String   @db.Uuid
  instalmentNo       Int
  dueDate            DateTime
  principalMinor     BigInt
  interestMinor      BigInt
  paidPrincipalMinor BigInt   @default(0)
  paidInterestMinor  BigInt   @default(0)
  status             String   @default("DUE") // DUE | PARTIAL | PAID | OVERDUE
  reminderSent       Boolean  @default(false)
  loan               Loan     @relation(fields: [loanId], references: [id])

  @@unique([loanId, instalmentNo])
  @@index([status, dueDate])
}

model LoanPayment {
  id             String   @id @default(uuid()) @db.Uuid
  loanId         String   @db.Uuid
  paymentId      String?  @unique @db.Uuid
  amountMinor    BigInt
  principalMinor BigInt
  interestMinor  BigInt
  createdAt      DateTime @default(now())
  loan           Loan     @relation(fields: [loanId], references: [id])
}

model SavingsGoal {
  id              String    @id @default(uuid()) @db.Uuid
  customerId      String    @db.Uuid
  name            String
  targetMinor     BigInt
  targetDate      DateTime?
  status          String    @default("ACTIVE") // ACTIVE | ACHIEVED | CLOSED
  ledgerAccountId String    @unique @db.Uuid // LIABILITY account: the saved balance of the goal
  createdAt       DateTime  @default(now())

  @@index([customerId, status])
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  category   String
  limitMinor BigInt
  alertLevel Int      @default(0) // highest threshold already notified this month: 0 | 80 | 100
  alertMonth String? // YYYY-MM the alertLevel refers to
  createdAt  DateTime @default(now())

  @@unique([customerId, category])
}

// ───────────────────────── Phase 7: advanced banking services ─────────────────────────

model Dispute {
  id             String    @id @default(uuid()) @db.Uuid
  reference      String    @unique
  customerId     String    @db.Uuid
  paymentId      String    @db.Uuid
  reasonCode     String // UNAUTHORISED | WRONG_AMOUNT | DUPLICATE | NOT_RECEIVED | OTHER
  description    String
  status         String    @default("OPEN") // OPEN | UNDER_REVIEW | ACCEPTED | REJECTED
  assignedToId   String?   @db.Uuid
  resolution     String?
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
}

model SupportTicket {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique
  customerId   String    @db.Uuid
  subject      String
  category     String // GENERAL | ACCOUNT | CARD | PAYMENT | LOAN | TECHNICAL
  status       String    @default("OPEN") // OPEN | PENDING_CUSTOMER | RESOLVED | CLOSED
  priority     String    @default("NORMAL")
  assignedToId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?

  messages     SupportMessage[]
  attachments  SupportAttachment[]

  @@index([customerId, status])
  @@index([status, updatedAt])
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  authorId   String        @db.Uuid
  authorType String // CUSTOMER | STAFF
  body       String
  internal   Boolean       @default(false) // staff-only note, never shown to the customer
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model SupportAttachment {
  id           String        @id @default(uuid()) @db.Uuid
  ticketId     String        @db.Uuid
  uploadedById String        @db.Uuid
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String
  storageKey   String        @unique
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Appointment {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @db.Uuid
  branchId     String    @db.Uuid
  purpose      String
  preferredAt  DateTime
  status       String    @default("REQUESTED") // REQUESTED | CONFIRMED | CANCELLED | COMPLETED
  confirmedAt  DateTime?
  confirmedFor DateTime?
  decidedById  String?   @db.Uuid
  note         String?
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([status, preferredAt])
}

model PaymentRequest {
  id                String    @id @default(uuid()) @db.Uuid
  reference         String    @unique
  requesterId       String    @db.Uuid
  payerId           String    @db.Uuid
  receiveAccountId  String    @db.Uuid
  amountMinor       BigInt
  currency          String    @default("LKR")
  note              String?
  status            String    @default("PENDING") // PENDING | PAID | DECLINED | CANCELLED | EXPIRED
  paymentId         String?   @db.Uuid
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([payerId, status])
  @@index([requesterId, status])
}

model PaymentTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  name            String
  sourceAccountId String?  @db.Uuid
  destination     Json // the same destination spec the payment API accepts
  amountMinor     BigInt?
  note            String?
  createdAt       DateTime @default(now())

  @@unique([customerId, name])
}
